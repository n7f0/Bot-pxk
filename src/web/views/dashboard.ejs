<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PXKK - Dashboard</title>
    <style>
        /* (O CSS do Dashboard que você gostou entra aqui. Para resumir, use o mesmo background) */
        body { background: #040404; color: #fff; font-family: 'Inter', sans-serif; padding: 20px; }
        .navbar { display: flex; justify-content: space-between; align-items: center; padding: 20px; background: rgba(10,10,10,0.8); border-radius: 99px; border: 1px solid rgba(255,255,255,0.1); margin-bottom: 30px; }
        .container { max-width: 800px; margin: 0 auto; background: rgba(10,10,10,0.6); padding: 40px; border-radius: 32px; border: 1px solid rgba(255,255,255,0.1); }
        .form-group { margin-bottom: 20px; }
        label { display: block; font-size: 12px; font-weight: 700; color: #B8B8C2; margin-bottom: 8px; text-transform: uppercase; }
        input[type="text"], input[type="number"] { width: 100%; padding: 16px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; color: #fff; outline: none; }
        input:focus { border-color: #8A4FFF; }
        button { padding: 16px 32px; background: #8A4FFF; color: white; border: none; border-radius: 99px; font-weight: bold; cursor: pointer; width: 100%; }
        button:hover { background: #A370FF; }
    </style>
</head>
<body>
    <div class="navbar">
        <h2>PXKK Dashboard</h2>
        <div>
            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" width="40" style="border-radius: 50%; vertical-align: middle; margin-right: 10px;">
            <b><%= user.username %></b>
            <a href="/logout" style="color: #f87171; margin-left: 15px; text-decoration: none;">Sair</a>
        </div>
    </div>

    <div class="container">
        <h1>Configurações</h1>
        <p style="color: #7A7A88; margin-bottom: 30px;">As alterações são aplicadas automaticamente no bot.</p>

        <% if (messages.length > 0) { %>
            <div style="background: rgba(74, 222, 128, 0.1); border: 1px solid #4ade80; padding: 15px; border-radius: 10px; color: #4ade80; margin-bottom: 20px;">
                <%= messages[0] %>
            </div>
        <% } %>

        <form method="POST">
            <div class="form-group">
                <label>Nome da Marca</label>
                <input type="text" name="brand_name" value="<%= cfg.brand_name %>">
            </div>
            <div class="form-group">
                <label>XP por Mensagem (Níveis)</label>
                <input type="number" name="levels_xp_per_message" value="<%= cfg.levels_xp_per_message %>">
            </div>
            <div class="form-group">
                <label>
                    <input type="checkbox" name="levels_enabled" <%= cfg.levels_enabled ? 'checked' : '' %>> 
                    Ativar Sistema de Níveis
                </label>
            </div>
            <button type="submit">Salvar Alterações</button>
        </form>
    </div>
</body>
</html>